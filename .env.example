# =============================================================================
# .env.example — Asistente Legal (copiá a .env y completá los valores)
# =============================================================================
# La instalación corre 100% local: PostgreSQL + Qdrant en Docker y Ollama para
# los modelos. No se usan servicios externos; con MODO_LOCAL=1 la app se niega
# a arrancar si algún endpoint apunta fuera de la máquina.
# =============================================================================

# --------------------------- Postgres ---------------------------------------
POSTGRES_USER=asistente_legal
POSTGRES_PASSWORD=<cambiar>
POSTGRES_DB=asistente_legal
POSTGRES_PORT=5432
# Pool de conexiones (SQLAlchemy). Cada consulta con streaming retiene su
# conexión mientras se consume el body; el default (5+10) se agota con polling.
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20
PG_POOL_RECYCLE=1800

# --------------------------- Qdrant -----------------------------------------
# Puertos internos del contenedor; no se mapean al host.
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# Opcional: solo si el servidor Qdrant exige API key. Vacía = sin autenticación.
# QDRANT_API_KEY=

# --------------------------- Auth -------------------------------------------
# Secreto JWT. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<cambiar-por-un-secreto-aleatorio-de-32+-caracteres>

# --------------------------- Modo local -------------------------------------
# 1 = la app no arranca si algún endpoint de LLM/embeddings/reranker sale de la
# máquina/red local, y el login no pide 2FA por email.
MODO_LOCAL=1

# --------------------------- Modelos (Ollama) --------------------------------
LLM_PROVIDER=ollama
# Ollama en el host -> 127.0.0.1; en compose (--profile ai) -> http://ollama:11434
OLLAMA_HOST=http://127.0.0.1:11434
# Modelo que redacta las respuestas. llama3:8b necesita ~8 GB de RAM libres.
LLM_MODEL_NAME=llama3:8b
# El embedder NO se cambia después de instalar: invalida el corpus indexado.
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_TEXT_BATCH_SIZE=64

# --------------------------- Upload -----------------------------------------
MAX_PDF_SIZE_MB=500

# --------------------------- Operativas -------------------------------------
# Empíricos: no ajustar en runtime.
QDRANT_UPSERT_BATCH_SIZE=256
OLLAMA_TIMEOUT_SECONDS=300
# 1/true SOLO durante una migración de modelo de embedding (reindexa el corpus).
SAFETY_ALLOW_COLLECTION_RECREATE=false

# --------------------------- Observabilidad ---------------------------------
# LOG_LEVEL=INFO
