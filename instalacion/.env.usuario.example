# =============================================================================
# .env.usuario.example — Instalación de usuario (todo local, sin APIs externas)
# =============================================================================
# Lo usa compose.usuario.yml. El instalador lo copia a .env y reemplaza cada
# marcador de secreto por uno aleatorio; no hace falta editarlo a mano.
# Para desarrollo se usa .env.example, no este archivo.
# =============================================================================

# Versión instalada (imagen ghcr.io/OWNER/asistente-legal:<VERSION>).
# El actualizador la cambia; volver a la anterior = poner el número viejo.
VERSION=0.1.0

# Puerto de la app en esta máquina: http://localhost:8080
PUERTO_APP=8080

# Ningún dato sale de la máquina: la app no arranca si algún endpoint apunta a
# internet, y el login no usa 2FA por email.
MODO_LOCAL=1

# --------------------------- Bases de datos ---------------------------------
POSTGRES_USER=asistente_legal
POSTGRES_PASSWORD=__GENERAR__
POSTGRES_DB=asistente_legal
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --------------------------- Seguridad --------------------------------------
SECRET_KEY=__GENERAR__

# --------------------------- Modelos (Ollama local) --------------------------
LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
# Modelo que redacta las respuestas. llama3:8b necesita ~8 GB de RAM libres.
# Alternativas en el manual de usuario; tras cambiarlo: descargarlo en Ollama
# (docker compose exec ollama ollama pull <modelo>) y reiniciar la app.
LLM_MODEL_NAME=llama3:8b
# El embedder NO se cambia después de instalar: invalida el corpus indexado.
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DIM=768

# --------------------------- Archivos ---------------------------------------
UPLOAD_DIR=/datos/uploads
MAX_PDF_SIZE_MB=500
LOG_LEVEL=INFO
