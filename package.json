{
  "name": "asistente-legal",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:app": "concurrently -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:db": "docker compose up -d postgres qdrant",
    "dev:api": "cd backend && uv run uvicorn src.main:app --reload --reload-dir src --host 127.0.0.1 --port 8000",
    "dev:web": "cd frontend && pnpm dev",
    "seed": "cd backend && uv run python scripts/seed_usuarios.py",
    "db:migrate": "cd backend && uv run alembic upgrade head",
    "db:stop": "docker compose stop postgres qdrant",
    "db:status": "docker compose ps"
  }
}
